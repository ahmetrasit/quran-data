["78:36:5"]],["bir",["78:36:4"]],["armağan",["78:36:4"]],["olarak",["78:36:4","78:36:5"]],["verilen",["78:36:4"]],["karşılık",["78:36:1"]]]}],["78:37","رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًۭا","78:37",{"source_ref":"78:37","text":"Göklerin, yerin ve ikisi arasındakilerin Rabbi, Rahman'dır; onlar O'ndan söz söyleme yetkisi elde edemezler.","target_tokens":[["Göklerin",["78:37:2"]],["yerin",["78:37:3"]],["ve",["78:37:4"]],["ikisi",["78:37:4","78:37:5"]],["arasındakilerin",["78:37:4","78:37:5"]],["Rabbi",["78:37:1"]],["Rahman'dır",["78:37:6"]],["onlar",["78:37:8"]],["O'ndan",["78:37:9"]],["söz",["78:37:10"]],["söyleme",["78:37:10"]],["yetkisi",["78:37:10"]],["elde",["78:37:8"]],["edemezler",["78:37:7","78:37:8"]]]}],["78:38","يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا","78:38",{"source_ref":"78:38","text":"Ruh ile meleklerin saf saf durduğu gün, Rahman'ın izin verdiği ve doğru söz söyleyen dışında kimse konuşamaz.","target_tokens":[["Ruh",["78:38:3"]],["ile",["78:38:4"]],["meleklerin",["78:38:4"]],["saf",["78:38:5"]],["saf",["78:38:5"]],["durduğu",["78:38:2"]],["gün",["78:38:1"]],["Rahman'ın",["78:38:12"]],["izin",["78:38:10"]],["verdiği",["78:38:10","78:38:11"]],["ve",["78:38:13"]],["doğru",["78:38:14"]],["söz",["78:38:14"]],["söyleyen",["78:38:13","78:38:14"]],["dışında",["78:38:8","78:38:9"]],["kimse",["78:38:9"]],["konuşamaz",["78:38:6","78:38:7"]]]}],["78:39","ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","78:39",{"source_ref":"78:39","text":"İşte o gerçek gündür. Artık dileyen Rabbine doğru bir dönüş yolu tutsun.","target_tokens":[["İşte",["78:39:1"]],["o",["78:39:1"]],["gerçek",["78:39:3"]],["gündür",["78:39:2","78:39:3"]],["Artık",["78:39:4"]],["dileyen",["78:39:4","78:39:5"]],["Rabbine",["78:39:8"]],["doğru",["78:39:7"]],["bir",["78:39:9"]],["dönüş",["78:39:9"]],["yolu",["78:39:9"]],["tutsun",["78:39:6"]]]}],["78:40","إِنَّآ أَنذَرْنَٰكُمْ عَذَابًۭا قَرِيبًۭا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَٰلَيْتَنِى كُنتُ تُرَٰبًۢا","78:40",{"source_ref":"78:40","text":"Şüphesiz sizi yakın bir azap konusunda uyardık: O gün kişi iki elinin önden gönderdiği şeye bakar ve inkâr eden, 'Keşke toprak olsaydım!' der.","target_tokens":[["Şüphesiz",["78:40:1"]],["sizi",["78:40:2"]],["yakın",["78:40:4"]],["bir",["78:40:3"]],["azap",["78:40:3"]],["konusunda",["78:40:3"]],["uyardık",["78:40:1","78:40:2"]],["O",["78:40:5"]],["gün",["78:40:5"]],["kişi",["78:40:7"]],["iki",["78:40:10"]],["elinin",["78:40:10"]],["önden",["78:40:9"]],["gönderdiği",["78:40:9"]],["şeye",["78:40:8"]],["bakar",["78:40:6"]],["ve",["78:40:11"]],["inkâr",["78:40:12"]],["eden",["78:40:12"]],["Keşke",["78:40:13"]],["toprak",["78:40:15"]],["olsaydım",["78:40:14"]],["der",["78:40:11"]]]}]]}
