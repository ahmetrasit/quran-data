{"protocol":"v12-cross-run-ayah-roster-v3","surah":86,"language":"tr","baseline_sha256":"342d21ea782e1535118e1fbceef2a19a427c0c8c0b704026dac8a6bfc6c07291","columns":["ayah_ref","text_ar","baseline_source_ref","baseline"],"rows":[["86:0","بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","1:1",{"source_ref":"1:1","text":"Merhameti sınırsız, merhamet eden Allah'ın adıyla.","target_tokens":[["Merhameti",["1:1:3"]],["sınırsız",["1:1:3"]],["merhamet",["1:1:4"]],["eden",["1:1:4"]],["Allah'ın",["1:1:2"]],["adıyla",["1:1:1"]]]}],["86:1","وَٱلسَّمَآءِ وَٱلطَّارِقِ","86:1",{"source_ref":"86:1","text":"Göğe ve gece gelene andolsun.","target_tokens":[["Göğe",["86:1:1"]],["ve",["86:1:2"]],["gece",["86:1:2"]],["gelene",["86:1:2"]],["andolsun",["86:1:1","86:1:2"]]]}],["86:2","وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","86:2",{"source_ref":"86:2","text":"Ve gece gelenin ne olduğunu sana ne bildirdi?","target_tokens":[["Ve",["86:2:1"]],["gece",["86:2:4"]],["gelenin",["86:2:4"]],["ne",["86:2:3"]],["olduğunu",["86:2:3","86:2:4"]],["sana",["86:2:2"]],["ne",["86:2:1"]],["bildirdi",["86:2:2"]]]}],["86:3","ٱلنَّجْمُ ٱلثَّاقِبُ","86:3",{"source_ref":"86:3","text":"Delip geçen yıldızdır.","target_tokens":[["Delip",["86:3:2"]],["geçen",["86:3:2"]],["yıldızdır",["86:3:1"]]]}],["86:4","إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","86:4",{"source_ref":"86:4","text":"Her canın üzerinde mutlaka bir gözetleyici vardır.","target_tokens":[["Her",["86:4:2"]],["canın",["86:4:3"]],["üzerinde",["86:4:5"]],["mutlaka",["86:4:1","86:4:4"]],["bir",["86:4:6"]],["gözetleyici",["86:4:6"]],["vardır",["86:4:4","86:4:5","86:4:6"]]]}],["86:5","فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","86:5",{"source_ref":"86:5","text":"Öyleyse insan neyden yaratıldığına baksın.","target_tokens":[["Öyleyse",["86:5:1"]],["insan",["86:5:2"]],["neyden",["86:5:3"]],["yaratıldığına",["86:5:4"]],["baksın",["86:5:1"]]]}],["86:6","خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","86:6",{"source_ref":"86:6","text":"Fışkıran bir sudan yaratıldı.","target_tokens":[["Fışkıran",["86:6:4"]],["bir",["86:6:3"]],["sudan",["86:6:2","86:6:3"]],["yaratıldı",["86:6:1"]]]}],["86:7","يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","86:7",{"source_ref":"86:7","text":"Bel kemiği ile göğüs kemikleri arasından çıkar.","target_tokens":[["Bel",["86:7:4"]],["kemiği",["86:7:4"]],["ile",["86:7:5"]],["göğüs",["86:7:5"]],["kemikleri",["86:7:5"]],["arasından",["86:7:2","86:7:3"]],["çıkar",["86:7:1"]]]}],["86:8","إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","86:8",{"source_ref":"86:8","text":"Şüphesiz O'nun onu geri döndürmeye elbette gücü yeter.","target_tokens":[["Şüphesiz",["86:8:1"]],["O'nun",["86:8:1"]],["onu",["86:8:3"]],["geri",["86:8:3"]],["döndürmeye",["86:8:3"]],["elbette",["86:8:4"]],["gücü",["86:8:4"]],["yeter",["86:8:2","86:8:4"]]]}],["86:9","يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","86:9",{"source_ref":"86:9","text":"Sırların sınanacağı gün.","target_tokens":[["Sırların",["86:9:3"]],["sınanacağı",["86:9:2"]],["gün",["86:9:1"]]]}],["86:10","فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","86:10",{"source_ref":"86:10","text":"Artık onun ne bir gücü ne de bir yardımcısı olur.","target_tokens":[["Artık",["86:10:1"]],["onun",["86:10:2"]],["ne",["86:10:1"]],["bir",["86:10:3","86:10:4"]],["gücü",["86:10:4"]],["ne",["86:10:5"]],["de",["86:10:5"]],["bir",["86:10:6"]],["yardımcısı",["86:10:6"]],["olur",["86:10:1","86:10:2"]]]}],["86:11","وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","86:11",{"source_ref":"86:11","text":"Dönüşü olan göğe andolsun.","target_tokens":[["Dönüşü",["86:11:3"]],["olan",["86:11:2"]],["göğe",["86:11:1"]],["andolsun",["86:11:1"]]]}],["86:12","وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","86:12",{"source_ref":"86:12","text":"Yarılan yere de andolsun.","target_tokens":[["Yarılan",["86:12:2","86:12:3"]],["yere",["86:12:1"]],["de",["86:12:1"]],["andolsun",["86:12:1"]]]}],["86:13","إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","86:13",{"source_ref":"86:13","text":"Şüphesiz o, kesin bir sözdür.","target_tokens":[["Şüphesiz",["86:13:1"]],["o",["86:13:1"]],["kesin",["86:13:3"]],["bir",["86:13:2"]],["sözdür",["86:13:2"]]]}],["86:14","وَمَا هُوَ بِٱلْهَزْلِ","86:14",{"source_ref":"86:14","text":"Ve o, şaka değildir.","target_tokens":[["Ve",["86:14:1"]],["o",["86:14:2"]],["şaka",["86:14:3"]],["değildir",["86:14:1","86:14:3"]]]}],["86:15","إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","86:15",{"source_ref":"86:15","text":"Şüphesiz onlar bir tuzak kuruyorlar.","target_tokens":[["Şüphesiz",["86:15:1"]],["onlar",["86:15:1"]],["bir",["86:15:3"]],["tuzak",["86:15:3"]],["kuruyorlar",["86:15:2"]]]}],["86:16","وَأَكِيدُ كَيْدًۭا","86:16",{"source_ref":"86:16","text":"Ben de bir tuzak kuruyorum.","target_tokens":[["Ben",["86:16:1"]],["de",["86:16:1"]],["bir",["86:16:2"]],["tuzak",["86:16:2"]],["kuruyorum",["86:16:1"]]]}],["86:17","فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","86:17",{"source_ref":"86:17","text":"Öyleyse inkâr edenlere süre ver; onlara biraz süre tanı.","target_tokens":[["Öyleyse",["86:17:1"]],["inkâr",["86:17:2"]],["edenlere",["86:17:2"]],["süre",["86:17:1"]],["ver",["86:17:1"]],["onlara",["86:17:3"]],["biraz",["86:17:4"]],["süre",["86:17:3"]],["tanı",["86:17:3"]]]}]]}
