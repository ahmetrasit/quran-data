_ref":"84:22","text":"Aksine, inkâr edenler yalanlıyorlar.","target_tokens":[["Aksine",["84:22:1"]],["inkâr",["84:22:3"]],["edenler",["84:22:2","84:22:3"]],["yalanlıyorlar",["84:22:4"]]]}],["84:23","وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ","84:23",{"source_ref":"84:23","text":"Allah onların içlerinde sakladıklarını en iyi bilir.","target_tokens":[["Allah",["84:23:1"]],["onların",["84:23:4"]],["içlerinde",["84:23:3","84:23:4"]],["sakladıklarını",["84:23:3","84:23:4"]],["en",["84:23:2"]],["iyi",["84:23:2"]],["bilir",["84:23:2"]]]}],["84:24","فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","84:24",{"source_ref":"84:24","text":"Öyleyse onlara acı bir azabı müjdele.","target_tokens":[["Öyleyse",["84:24:1"]],["onlara",["84:24:1"]],["acı",["84:24:3"]],["bir",["84:24:2"]],["azabı",["84:24:2"]],["müjdele",["84:24:1"]]]}],["84:25","إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ","84:25",{"source_ref":"84:25","text":"Ancak inanıp iyi işler yapanlar için kesintisiz bir ödül vardır.","target_tokens":[["Ancak",["84:25:1"]],["inanıp",["84:25:3"]],["iyi",["84:25:5"]],["işler",["84:25:5"]],["yapanlar",["84:25:2","84:25:4"]],["için",["84:25:6"]],["kesintisiz",["84:25:8","84:25:9"]],["bir",["84:25:7"]],["ödül",["84:25:7"]],["vardır",["84:25:6","84:25:7"]]]}]]}
