{"protocol":"v12-cross-run-ayah-roster-v3","surah":84,"language":"tr","baseline_sha256":"be25e03afb18987007516d7c5699a67879d70e251261fac65bda4b5033563f74","columns":["ayah_ref","text_ar","baseline_source_ref","baseline"],"rows":[["84:0","بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","1:1",{"source_ref":"1:1","text":"Merhameti sınırsız, merhamet eden Allah'ın adıyla.","target_tokens":[["Merhameti",["1:1:3"]],["sınırsız",["1:1:3"]],["merhamet",["1:1:4"]],["eden",["1:1:4"]],["Allah'ın",["1:1:2"]],["adıyla",["1:1:1"]]]}],["84:1","إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","84:1",{"source_ref":"84:1","text":"Gök yarıldığında,","target_tokens":[["Gök",["84:1:2"]],["yarıldığında",["84:1:1","84:1:3"]]]}],["84:2","وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","84:2",{"source_ref":"84:2","text":"Rabbine kulak verdiğinde ve buna yükümlü kılındığında,","target_tokens":[["Rabbine",["84:2:2"]],["kulak",["84:2:1"]],["verdiğinde",["84:2:1"]],["ve",["84:2:3"]],["buna",["84:2:3"]],["yükümlü",["84:2:3"]],["kılındığında",["84:2:3"]]]}],["84:3","وَإِذَا ٱلْأَرْضُ مُدَّتْ","84:3",{"source_ref":"84:3","text":"Yer uzatıldığında,","target_tokens":[["Yer",["84:3:2"]],["uzatıldığında",["84:3:1","84:3:3"]]]}],["84:4","وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","84:4",{"source_ref":"84:4","text":"İçindekileri atıp boşaldığında,","target_tokens":[["İçindekileri",["84:4:2","84:4:3"]],["atıp",["84:4:1"]],["boşaldığında",["84:4:4"]]]}],["84:5","وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","84:5",{"source_ref":"84:5","text":"Rabbine kulak verdiğinde ve buna yükümlü kılındığında;","target_tokens":[["Rabbine",["84:5:2"]],["kulak",["84:5:1"]],["verdiğinde",["84:5:1"]],["ve",["84:5:3"]],["buna",["84:5:3"]],["yükümlü",["84:5:3"]],["kılındığında",["84:5:3"]]]}],["84:6","يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ","84:6",{"source_ref":"84:6","text":"Ey insan, sen Rabbine doğru çabalayıp sonunda O'na kavuşacaksın.","target_tokens":[["Ey",["84:6:1"]],["insan",["84:6:2"]],["sen",["84:6:3"]],["Rabbine",["84:6:6"]],["doğru",["84