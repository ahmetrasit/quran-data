{"protocol":"v12-cross-run-ayah-roster-v3","surah":97,"language":"tr","baseline_sha256":"870afe10647fa89d17a31fabeba73d296d3578f418660cb3460ef53b3c92b839","columns":["ayah_ref","text_ar","baseline_source_ref","baseline"],"rows":[["97:0","بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","1:1",{"source_ref":"1:1","text":"Merhameti sınırsız, merhamet eden Allah'ın adıyla.","target_tokens":[["Merhameti",["1:1:3"]],["sınırsız",["1:1:3"]],["merhamet",["1:1:4"]],["eden",["1:1:4"]],["Allah'ın",["1:1:2"]],["adıyla",["1:1:1"]]]}],["97:1","إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ","97:1",{"source_ref":"97:1","text":"Şüphesiz biz onu Kadir Gecesi'nde indirdik.","target_tokens":[["Şüphesiz",["97:1:1"]],["biz",["97:1:1","97:1:2"]],["onu",["97:1:2"]],["Kadir",["97:1:5"]],["Gecesi'nde",["97:1:3","97:1:4","97:1:5"]],["indirdik",["97:1:2"]]]}],["97:2","وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ","97:2",{"source_ref":"97:2","text":"Ve Kadir Gecesi'nin ne olduğunu sana ne bildirdi?","target_tokens":[["Ve",["97:2:1"]],["Kadir",["97:2:5"]],["Gecesi'nin",["97:2:4","97:2:5"]],["ne",["97:2:3"]],["olduğunu",["97:2:3","97:2:4","97:2:5"]],["sana",["97:2:2"]],["ne",["97:2:1"]],["bildirdi",["97:2:2"]]]}],["97:3","لَيْلَةُ ٱلْقَدْرِ خَيْرٌۭ مِّنْ أَلْفِ شَهْرٍۢ","97:3",{"source_ref":"97:3","text":"Kadir Gecesi bin aydan daha iyidir.","target_tokens":[["Kadir",["97:3:2"]],["Gecesi",["97:3:1","97:3:2"]],["bin",["97:3:5"]],["aydan",["97:3:4","97:3:6"]],["daha",["97:3:3","97:3:4"]],["iyidir",["97:3:3"]]]}],["97:4","تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍۢ","97:4",{"source_ref":"97:4","text":"Melekler ve Ruh, Rablerinin izniyle onda her iş için inerler.","target_tokens":[["Melekler",["97:4:2"]],["ve",["97:4:3"]],["Ruh",["97:4:3"]],["Rablerinin",["97:4:6"]],["izniyle",["97:4:5","97:4:6"]],["onda",["97:4:4"]],["her",["97:4:8"]],["iş",["97:4:9"]],["için",["97:4:7","97:4:8","97:4:9"]],["inerler",["97:4:1","97:4:2","97:4:3"]]]}],["97:5","سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْ