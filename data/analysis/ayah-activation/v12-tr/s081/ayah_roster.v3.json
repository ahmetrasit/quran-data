:2","81:17:3"]],["geceye",["81:17:1"]]]}],["81:18","وَٱلصُّبْحِ إِذَا تَنَفَّسَ","81:18",{"source_ref":"81:18","text":"ve nefes alırken sabaha!","target_tokens":[["ve",["81:18:1"]],["nefes",["81:18:3"]],["alırken",["81:18:2","81:18:3"]],["sabaha",["81:18:1"]]]}],["81:19","إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","81:19",{"source_ref":"81:19","text":"O, gerçekten değerli bir elçinin sözüdür.","target_tokens":[["O",["81:19:1"]],["gerçekten",["81:19:1","81:19:2"]],["değerli",["81:19:4"]],["bir",["81:19:3"]],["elçinin",["81:19:3"]],["sözüdür",["81:19:2"]]]}],["81:20","ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ","81:20",{"source_ref":"81:20","text":"Güç sahibi, tahtın sahibinin katında itibarlı,","target_tokens":[["Güç",["81:20:2"]],["sahibi",["81:20:1"]],["tahtın",["81:20:5"]],["sahibinin",["81:20:4"]],["katında",["81:20:3"]],["itibarlı",["81:20:6"]]]}],["81:21","مُّطَاعٍۢ ثَمَّ أَمِينٍۢ","81:21",{"source_ref":"81:21","text":"orada sözü dinlenen, güvenilir.","target_tokens":[["orada",["81:21:2"]],["sözü",["81:21:1"]],["dinlenen",["81:21:1"]],["güvenilir",["81:21:3"]]]}],["81:22","وَمَا صَاحِبُكُم بِمَجْنُونٍۢ","81:22",{"source_ref":"81:22","text":"Ve arkadaşınız deli değildir.","target_tokens":[["Ve",["81:22:1"]],["arkadaşınız",["81:22:2"]],["deli",["81:22:3"]],["değildir",["81:22:1","81:22:3"]]]}],["81:23","وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","81:23",{"source_ref":"81:23","text":"Andolsun, onu apaçık ufukta gördü.","target_tokens":[["Andolsun",["81:23:1"]],["onu",["81:23:2"]],["apaçık",["81:23:4"]],["ufukta",["81:23:3"]],["gördü",["81:23:2"]]]}],["81:24","وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ","81:24",{"source_ref":"81:24","text":"O, görünmeyene ilişkin bilgiyi esirgemez.","target_tokens":[["O",["81:24:2"]],["görünmeyene",["81:24:4"]],["ilişkin",["81:24:3","81:24:4"]],["bilgiyi",["81:24:4"]],["esirgemez",["81:24:1","81:24:5"]]]}],["81:25","وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ","81:25",{"source_ref":"81:25","text":"O, kovulmuş bir şeytanın sözü değildir.","target_tokens":[["O",["81:25:2"]],["kovulmuş",["81:25:5"]],["bir",["81:25:4"]],["şeytanın",["81:25:4"]],["sözü",["81:25:3"]],["değildir",["81:25:1","81:25:3"]]]}],["81:26","فَأَيْنَ تَذْهَبُونَ","81:26",{"source_ref":"81:26","text":"Öyleyse nereye gidiyorsunuz?","target_tokens":[["Öyleyse",["81:26:1"]],["nereye",["81:26:1"]],["gidiyorsunuz",["81:26:2"]]]}],["81:27","إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","81:27",{"source_ref":"81:27","text":"O, bütün insanlar için yalnızca bir hatırlatmadır.","target_tokens":[["O",["81:27:2"]],["bütün",["81:27:5"]],["insanlar",["81:27:5"]],["için",["81:27:5"]],["yalnızca",["81:27:1","81:27:3"]],["bir",["81:27:4"]],["hatırlatmadır",["81:27:4"]]]}],["81:28","لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","81:28",{"source_ref":"81:28","text":"İçinizden dosdoğru olmak isteyen için.","target_tokens":[["İçinizden",["81:28:3"]],["dosdoğru",["81:28:5"]],["olmak",["81:28:4","81:28:5"]],["isteyen",["81:28:2"]],["için",["81:28:1"]]]}],["81:29","وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ","81:29",{"source_ref":"81:29","text":"Âlemlerin Rabbi Allah dilemedikçe siz dileyemezsiniz.","target_tokens":[["Âlemlerin",["81:29:8"]],["Rabbi",["81:29:7"]],["Allah",["81:29:6"]],["dilemedikçe",["81:29:3","81:29:4","81:29:5"]],["siz",["81:29:2"]],["dileyemezsiniz",["81:29:1","81:29:2"]]]}]]}
