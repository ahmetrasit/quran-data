{"protocol":"v12-cross-run-ayah-roster-v3","surah":96,"language":"tr","baseline_sha256":"fb5ef14b6fbdf08e692c1a35ffa87a198ad2833a7437f9ed9d6d5ae84e2786ad","columns":["ayah_ref","text_ar","baseline_source_ref","baseline"],"rows":[["96:0","بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","1:1",{"source_ref":"1:1","text":"Merhameti sınırsız, merhamet eden Allah'ın adıyla.","target_tokens":[["Merhameti",["1:1:3"]],["sınırsız",["1:1:3"]],["merhamet",["1:1:4"]],["eden",["1:1:4"]],["Allah'ın",["1:1:2"]],["adıyla",["1:1:1"]]]}],["96:1","ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","96:1",{"source_ref":"96:1","text":"Yaratan Rabbinin adıyla oku.","target_tokens":[["Yaratan",["96:1:4","96:1:5"]],["Rabbinin",["96:1:3"]],["adıyla",["96:1:2"]],["oku",["96:1:1"]]]}],["96:2","خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","96:2",{"source_ref":"96:2","text":"İnsanı bir kan pıhtısından yarattı.","target_tokens":[["İnsanı",["96:2:2"]],["bir",["96:2:4"]],["kan",["96:2:4"]],["pıhtısından",["96:2:3","96:2:4"]],["yarattı",["96:2:1"]]]}],["96:3","ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","96:3",{"source_ref":"96:3","text":"Oku; Rabbin en cömerttir.","target_tokens":[["Oku",["96:3:1"]],["Rabbin",["96:3:2"]],["en",["96:3:3"]],["cömerttir",["96:3:3"]]]}],["96:4","ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","96:4",{"source_ref":"96:4","text":"O, kalemle öğretendir.","target_tokens":[["O",["96:4:1"]],["kalemle",["96:4:3"]],["öğretendir",["96:4:2"]]]}],["96:5","عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","96:5",{"source_ref":"96:5","text":"İnsana bilmediğini öğretti.","target_tokens":[["İnsana",["96:5:2"]],["bilmediğini",["96:5:3","96:5:4","96:5:5"]],["öğretti",["96:5:1"]]]}],["96:6","كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","96:6",{"source_ref":"96:6","text":"Hayır! İnsan gerçekten sınırı aşar.","target_tokens":[["Hayır",["96:6:1"]],["İnsan",["96:6:3"]],["gerçekten",["96:6:2","96:6:4"]],["sınırı",["96:6:4"]],["aşar",["96:6:4"]]]}],["96:7","أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","96:7",{"source_ref":"96:7","text":"Kendisini yeterli gördüğü için.","target_tokens":[["Kendisini",["96:7:2"]],["yeterli",["96:7:3"]],["gördüğü",["96:7:2"]],["için",["96:7:1"]]]}],["96:8","إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","96:8",{"source_ref":"96:8","text":"Dönüş kesinlikle Rabbinedir.","target_tokens":[["Dönüş",["96:8:4"]],["kesinlikle",["96:8:1"]],["Rabbinedir",["96:8:2","96:8:3"]]]}],["96:9","أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","96:9",{"source_ref":"96:9","text":"Gördün mü şu engelleyeni?","target_tokens":[["Gördün",["96:9:1"]],["mü",["96:9:1"]],["şu",["96:9:2"]],["engelleyeni",["96:9:2","96:9:3"]]]}],["96:10","عَبْدًا إِذَا صَلَّىٰٓ","96:10",{"source_ref":"96:10","text":"Bir kulu namaz kıldığında?","target_tokens":[["Bir",["96:10:1"]],["kulu",["96:10:1"]],["namaz",["96:10:3"]],["kıldığında",["96:10:2","96:10:3"]]]}],["96:11","أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","96:11",{"source_ref":"96:11","text":"Gördün mü, ya o doğru yol üzerindeyse?","target_tokens":[["Gördün",["96:11:1"]],["mü",["96:11:1"]],["ya",["96:11:2"]],["o",["96:11:3"]],["doğru",["96:11:5"]],["yol",["96:11:5"]],["üzerindeyse",["96:11:3","96:11:4","96:11:5"]]]}],["96:12","أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","96:12",{"source_ref":"96:12","text":"Ya da sakınmayı emrediyorsa?","target_tokens":[["Ya",["96:12:1"]],["da",["96:12:1"]],["sakınmayı",["96:12:3"]],["emrediyorsa",["96:12:2"]]]}],["96:13","أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","96:13",{"source_ref":"96:13","text":"Gördün mü, ya yalanlayıp yüz çevirdiyse?","target_tokens":[["Gördün",["96:13:1"]],["mü",["96:13:1"]],["ya",["96:13:2"]],["yalanlayıp",["96:13:3","96:13:4"]],["yüz",["96:13:4"]],["çevirdiyse",["96:13:2","96:13:4"]]]}],["96:14","أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","96:14",{"source_ref":"96:14","text":"Allah'ın gördüğünü bilmiyor mu?","target_tokens":[["Allah'ın",["96:14:3","96:14:4"]],["gördüğünü",["96:14:3","96:14:5"]],["bilmiyor",["96:14:1","96:14:2"]],["mu",["96:14:1"]]]}],["96:15","كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","96:15",{"source_ref":"96:15","text":"Hayır! Eğer vazgeçmezse onu perçeminden mutlaka sürükleyeceğiz.","target_tokens":[["Hayır",["96:15:1"]],["Eğer",["96:15:2"]],["vazgeçmezse",["96:15:3","96:15:4"]],["onu",["96:15:5"]],["perçeminden",["96:15:6"]],["mutlaka",["96:15:2","96:15:5"]],["sürükleyeceğiz",["96:15:5"]]]}],["96:16","نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","96:16",{"source_ref":"96:16","text":"Yalancı, günahkâr bir perçemden.","target_tokens":[["Yalancı",["96:16:2"]],["günahkâr",["96:16:3"]],["bir",["96:16:1"]],["perçemden",["96:16:1"]]]}],["96:17","فَلْيَدْعُ نَادِيَهُۥ","96:17",{"source_ref":"96:17","text":"O hâlde topluluğunu çağırsın.","target_tokens":[["O",["96:17:1"]],["hâlde",["96:17:1"]],["topluluğunu",["96:17:2"]],["çağırsın",["96:17:1"]]]}],["96:18","سَنَدْعُ ٱلزَّبَانِيَةَ","96:18",{"source_ref":"96:18","text":"Biz zebanileri çağıracağız.","target_tokens":[["Biz",["96:18:1"]],["zebanileri",["96:18:2"]],["çağıracağız",["96:18:1"]]]}],["96:19","كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","96:19",{"source_ref":"96:19","text":"Hayır! Ona itaat etme, secde et ve yaklaş.","target_tokens":[["Hayır",["96:19:1"]],["Ona",["96:19:3"]],["itaat",["96:19:3"]],["etme",["96:19:2","96:19:3"]],["secde",["96:19:4"]],["et",["96:19:4"]],["ve",["96:19:5"]],["yaklaş",["96:19:5"]]]}]]}
