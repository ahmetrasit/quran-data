{"protocol":"v12-cross-run-ayah-roster-v3","surah":80,"language":"tr","baseline_sha256":"7ccd2f141fcda2d3555cd1ac059d736c05a6da6c199b0a05cf194dd6733d5a65","columns":["ayah_ref","text_ar","baseline_source_ref","baseline"],"rows":[["80:0","بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","1:1",{"source_ref":"1:1","text":"Merhameti sınırsız, merhamet eden Allah'ın adıyla.","target_tokens":[["Merhameti",["1:1:3"]],["sınırsız",["1:1:3"]],["merhamet",["1:1:4"]],["eden",["1:1:4"]],["Allah'ın",["1:1:2"]],["adıyla",["1:1:1"]]]}],["80:1","عَبَسَ وَتَوَلَّىٰٓ","80:1",{"source_ref":"80:1","text":"Yüzünü ekşitti ve yüz çevirdi.","target_tokens":[["Yüzünü",["80:1:1"]],["ekşitti",["80:1:1"]],["ve",["80:1:2"]],["yüz",["80:1:2"]],["çevirdi",["80:1:2"]]]}],["80:2","أَن جَآءَهُ ٱلْأَعْمَىٰ","80:2",{"source_ref":"80:2","text":"Kör kişi kendisine geldi diye.","target_tokens":[["Kör",["80:2:3"]],["kişi",["80:2:3"]],["kendisine",["80:2:2"]],["geldi",["80:2:2"]],["diye",["80:2:1"]]]}],["80:3","وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","80:3",{"source_ref":"80:3","text":"Sen ne bilebilirsin? Belki o arınacaktır.","target_tokens":[["Sen",["80:3:2"]],["ne",["80:3:1"]],["bilebilirsin",["80:3:2"]],["Belki",["80:3:3"]],["o",["80:3:3"]],["arınacaktır",["80:3:4"]]]}],["80:4","أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","80:4",{"source_ref":"80:4","text":"Ya da öğüt alır, öğüt de ona yarar sağlardı.","target_tokens":[["Ya",["80:4:1"]],["da",["80:4:1"]],["öğüt",["80:4:2"]],["alır",["80:4:2"]],["öğüt",["80:4:4"]],["de",["80:4:3"]],["ona",["80:4:3"]],["yarar",["80:4:3"]],["sağlardı",["80:4:3"]]]}],["80:5","أَمَّا مَنِ ٱسْتَغْنَىٰ","80:5",{"source_ref":"80:5","text":"Ama kendini yeterli görene gelince,","target_tokens":[["Ama",["80:5:1"]],["kendini",["80:5:3"]],["yeterli",["80:5:3"]],["görene",["80:5:2","80:5:3"]],["gelince",["80:5:1"]]]}],["80:6","فَأَنتَ لَهُۥ تَصَدَّىٰ","80:6",{"source_ref":"80:6","text":"Sen ona yöneliyorsun.","target_tokens":[["Sen",["80:6:1"]],["ona",["80:6:2"]],["yöneliyorsun",["80:6:3"]]]}],["80:7","وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","80:7",{"source_ref":"80:7","text":"Onun arınmamasından sen sorumlu değilsin.","target_tokens":[["Onun",["80:7:4"]],["arınmamasından",["80:7:3","80:7:4"]],["sen",["80:7:2"]],["sorumlu",["80:7:2"]],["değilsin",["80:7:1"]]]}],["80:8","وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","80:8",{"source_ref":"80:8","text":"Ama sana koşarak gelene gelince,","target_tokens":[["Ama",["80:8:1"]],["sana",["80:8:3"]],["koşarak",["80:8:4"]],["gelene",["80:8:2","80:8:3"]],["gelince",["80:8:1","80:8:2"]]]}],["80:9","وَهُوَ يَخْشَىٰ","80:9",{"source_ref":"80:9","text":"Oysa o korkuyordu.","target_tokens":[["Oysa",["80:9:1"]],["o",["80:9:1"]],["korkuyordu",["80:9:2"]]]}],["80:10","فَأَنتَ عَنْهُ تَلَهَّىٰ","80:10",{"source_ref":"80:10","text":"Sen ondan yüz çeviriyorsun.","target_tokens":[["Sen",["80:10:1"]],["ondan",["80:10:2"]],["yüz",["80:10:3"]],["çeviriyorsun",["80:10:3"]]]}],["80:11","كَلَّآ إِنَّهَا تَذْكِرَةٌۭ","80:11",{"source_ref":"80:11","text":"Hayır! Kuşkusuz o bir öğüttür.","target_tokens":[["Hayır",["80:11:1"]],["Kuşkusuz",["80:11:2"]],["o",["80:11:2"]],["bir",["80:11:3"]],["öğüttür",["80:11:3"]]]}],["80:12","فَمَن شَآءَ ذَكَرَهُۥ","80:12",{"source_ref":"80:12","text":"Artık dileyen onu hatırlar.","target_tokens":[["Artık",["80:12:1"]],["dileyen",["80:12:1","80:12:2"]],["onu",["80:12:3"]],["hatırlar",["80:12:3"]]]}],["80:13","فِى صُحُفٍۢ مُّكَرَّمَةٍۢ","80:13",{"source_ref":"80:13","text":"Değer verilen sayfalardadır;","target_tokens":[["Değer",["80:13:3"]],["verilen",["80:13:3"]],["sayfalardadır",["80:13:1","80:13:2"]]]}],["80:14","مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ","80:14",{"source_ref":"80:14","text":"yüceltilmiş, arındırılmış;","target_tokens":[["yüceltilmiş",["80:14:1"]],["arındırılmış",["80:14:2"]]]}],["80:15","بِأَيْدِى سَفَرَةٍۢ","80:15",{"source_ref":"80:15","text":"yazıcıların ellerindedir;","target_tokens":[["yazıcıların",["80:15:2"]],["ellerindedir",["80:15:1"]]]}],["80:16","كِرَامٍۭ بَرَرَةٍۢ","80:16",{"source_ref":"80:16","text":"d