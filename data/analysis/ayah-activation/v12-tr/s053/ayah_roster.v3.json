"53:24:2"]],["mudur",["53:24:1","53:24:2"]]]}],["53:25","فَلِلَّهِ ٱلْءَاخِرَةُ وَٱلْأُولَىٰ","53:25",{"source_ref":"53:25","text":"Oysa sonraki hayat da önceki hayat da Allah'ındır.","target_tokens":[["Oysa",["53:25:1"]],["sonraki",["53:25:2"]],["hayat",["53:25:2"]],["da",["53:25:2"]],["önceki",["53:25:3"]],["hayat",["53:25:3"]],["da",["53:25:3"]],["Allah'ındır",["53:25:1"]]]}],["53:26","۞ وَكَم مِّن مَّلَكٍۢ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ","53:26",{"source_ref":"53:26","text":"Göklerde nice melek vardır ki onların aracılığı, Allah'ın dilediği ve razı olduğu kimse için izin vermesinden sonra olmadıkça hiçbir yarar sağlamaz.","target_tokens":[["Göklerde",["53:26:4","53:26:5"]],["nice",["53:26:1","53:26:2"]],["melek",["53:26:3"]],["vardır",["53:26:1","53:26:3"]],["ki",["53:26:1"]],["onların",["53:26:8"]],["aracılığı",["53:26:8"]],["Allah'ın",["53:26:15"]],["dilediği",["53:26:17"]],["ve",["53:26:18"]],["razı",["53:26:18"]],["olduğu",["53:26:18"]],["kimse",["53:26:16"]],["için",["53:26:16"]],["izin",["53:26:14"]],["vermesinden",["53:26:13","53:26:14"]],["sonra",["53:26:11","53:26:12"]],["olmadıkça",["53:26:10"]],["hiçbir",["53:26:6","53:26:9"]],["yarar",["53:26:9"]],["sağlamaz",["53:26:6","53:26:7"]]]}],["53:27","إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ لَيُسَمُّونَ ٱلْمَلَٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ","53:27",{"source_ref":"53:27","text":"Ahirete inanmayanlar meleklere dişi adları veriyorlar.","target_tokens":[["Ahirete",["53:27:5"]],["inanmayanlar",["53:27:1","53:27:2","53:27:3","53:27:4"]],["meleklere",["53:27:7"]],["dişi",["53:27:9"]],["adları",["53:27:8","53:27:9"]],["veriyorlar",["53:27:6"]]]}],["53:28","وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًۭٔا","53:28",{"source_ref":"53:28","text":"Oysa bu konuda hiçbir bilgileri yoktur. Onlar yalnızca zanna uyuyorlar. Zan ise gerçek karşısında hiçbir işe 