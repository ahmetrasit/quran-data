,["misiniz",["56:70:5","56:70:6"]]]}],["56:71","أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","56:71",{"source_ref":"56:71","text":"Tutuşturduğunuz ateşi gördünüz mü?","target_tokens":[["Tutuşturduğunuz",["56:71:3","56:71:4"]],["ateşi",["56:71:2"]],["gördünüz",["56:71:1"]],["mü",["56:71:1"]]]}],["56:72","ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","56:72",{"source_ref":"56:72","text":"Onun ağacını siz mi var ettiniz, yoksa var eden biz miyiz?","target_tokens":[["Onun",["56:72:3"]],["ağacını",["56:72:3"]],["siz",["56:72:1"]],["mi",["56:72:1"]],["var",["56:72:2"]],["ettiniz",["56:72:2"]],["yoksa",["56:72:4"]],["var",["56:72:6"]],["eden",["56:72:6"]],["biz",["56:72:5"]],["miyiz",["56:72:4","56:72:5","56:72:6"]]]}],["56:73","نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ","56:73",{"source_ref":"56:73","text":"Onu bir hatırlatma ve yolcular için bir yarar kıldık","target_tokens":[["Onu",["56:73:2"]],["bir",["56:73:3"]],["hatırlatma",["56:73:3"]],["ve",["56:73:4"]],["yolcular",["56:73:5"]],["için",["56:73:5"]],["bir",["56:73:4"]],["yarar",["56:73:4"]],["kıldık",["56:73:1","56:73:2"]]]}],["56:74","فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","56:74",{"source_ref":"56:74","text":"Öyleyse yüce Rabbinin adını anıp yücelt","target_tokens":[["Öyleyse",["56:74:1"]],["yüce",["56:74:4"]],["Rabbinin",["56:74:3"]],["adını",["56:74:2"]],["anıp",["56:74:1","56:74:2"]],["yücelt",["56:74:1","56:74:4"]]]}],["56:75","۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","56:75",{"source_ref":"56:75","text":"Hayır, yıldızların yerlerine yemin ederim","target_tokens":[["Hayır",["56:75:1"]],["yıldızların",["56:75:4"]],["yerlerine",["56:75:3"]],["yemin",["56:75:2"]],["ederim",["56:75:2"]]]}],["56:76","وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ","56:76",{"source_ref":"56:76","text":"Bilseniz bu gerçekten büyük bir yemindir","target_tokens":[["Bilseniz",["56:76:3","56:76:4"]],["bu",["56:76:1"]],["gerçekten",["56:76:1","56:76:2"]],["büyük",["56:76:5"]],["bir",["56:76:2"]],["yemindir",["56:76:2"]]]}],["56:77","إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ","56:77",{"source_ref":"56:77","text":"Şüphesiz o değerli bir Kur'an'dır","target_tokens":[["Şüphesiz",["56:77:1"]],["o",["56:77:1"]],["değerli",["56:77:3"]],["bir",["56:77:2"]],["Kur'an'dır",["56:77:2"]]]}],["56:78","فِى كِتَٰبٍۢ مَّكْنُونٍۢ","56:78",{"source_ref":"56:78","text":"Korunmuş bir kitaptadır","target_tokens":[["Korunmuş",["56:78:3"]],["bir",["56:78:2"]],["kitaptadır",["56:78:1","56:78:2"]]]}],["56:79","لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ","56:79",{"source_ref":"56:79","text":"Ona ancak arındırılmış olanlar dokunur","target_tokens":[["Ona",["56:79:2"]],["ancak",["56:79:3"]],["arındırılmış",["56:79:4"]],["olanlar",["56:79:4"]],["dokunur",["56:79:1","56:79:2"]]]}],["56:80","تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ","56:80",{"source_ref":"56:80","text":"Âlemlerin Rabbinden indirilmiştir","target_tokens":[["Âlemlerin",["56:80:4"]],["Rabbinden",["56:80:3"]],["indirilmiştir",["56:80:1","56:80:2"]]]}],["56:81","أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","56:81",{"source_ref":"56:81","text":"Şimdi siz bu sözü küçümsüyor musunuz?","target_tokens":[["Şimdi",["56:81:1"]],["siz",["56:81:3"]],["bu",["56:81:1"]],["sözü",["56:81:2"]],["küçümsüyor",["56:81:4"]],["musunuz",["56:81:1","56:81:4"]]]}],["56:82","وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","56:82",{"source_ref":"56:82","text":"Size verilen rızka karşılık yalanlamayı mı koyuyorsunuz?","target_tokens":[["Size",["56:82:2"]],["verilen",["56:82:2"]],["rızka",["56:82:2"]],["karşılık",["56:82:1","56:82:2"]],["yalanlamayı",["56:82:3","56:82:4"]],["mı",["56:82:3"]],["koyuyorsunuz",["56:82:1"]]]}],["56:83","فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","56:83",{"source_ref":"56:83","text":"Can boğaza ulaştığında","target_tokens":[["Can",["56:83:3"]],["boğaza",["56:83:4"]],["ulaştığında",["56:83:1","56:83:2","56:83:3"]]]}],["56:84","وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ","56:84",{"source_ref":"56:84","text":"Siz o sırada bakıp durursunuz","target_tokens":[["Siz",["56:8