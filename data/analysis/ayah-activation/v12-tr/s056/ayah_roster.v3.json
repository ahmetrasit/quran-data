:"Sağdakilerden sana selam vardır","target_tokens":[["Sağdakilerden",["56:91:4","56:91:5"]],["sana",["56:91:2"]],["selam",["56:91:1"]],["vardır",["56:91:1","56:91:3"]]]}],["56:92","وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","56:92",{"source_ref":"56:92","text":"Ama yalanlayan sapkınlardan ise","target_tokens":[["Ama",["56:92:1"]],["yalanlayan",["56:92:5"]],["sapkınlardan",["56:92:4","56:92:6"]],["ise",["56:92:1","56:92:2","56:92:3"]]]}],["56:93","فَنُزُلٌۭ مِّنْ حَمِيمٍۢ","56:93",{"source_ref":"56:93","text":"Ona kaynar sudan bir ikram","target_tokens":[["Ona",["56:93:1"]],["kaynar",["56:93:3"]],["sudan",["56:93:2","56:93:3"]],["bir",["56:93:1"]],["ikram",["56:93:1"]]]}],["56:94","وَتَصْلِيَةُ جَحِيمٍ","56:94",{"source_ref":"56:94","text":"Ve cehenneme atılma vardır","target_tokens":[["Ve",["56:94:1"]],["cehenneme",["56:94:2"]],["atılma",["56:94:1"]],["vardır",["56:94:1","56:94:2"]]]}],["56:95","إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ","56:95",{"source_ref":"56:95","text":"Şüphesiz bu, kesin gerçeğin ta kendisidir","target_tokens":[["Şüphesiz",["56:95:1"]],["bu",["56:95:2"]],["kesin",["56:95:5"]],["gerçeğin",["56:95:4","56:95:5"]],["ta",["56:95:3"]],["kendisidir",["56:95:3","56:95:4"]]]}],["56:96","فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","56:96",{"source_ref":"56:96","text":"Öyleyse yüce Rabbinin adını anıp yücelt","target_tokens":[["Öyleyse",["56:96:1"]],["yüce",["56:96:4"]],["Rabbinin",["56:96:3"]],["adını",["56:96:2"]],["anıp",["56:96:1","56:96:2"]],["yücelt",["56:96:1","56:96:4"]]]}]]}
