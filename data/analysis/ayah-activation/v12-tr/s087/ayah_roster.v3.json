{"protocol":"v12-cross-run-ayah-roster-v3","surah":87,"language":"tr","baseline_sha256":"e469403b885fa0f47dc88a2d9e94b1c08b8e91455f256c836fdc90a99ce626aa","columns":["ayah_ref","text_ar","baseline_source_ref","baseline"],"rows":[["87:0","بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","1:1",{"source_ref":"1:1","text":"Merhameti sınırsız, merhamet eden Allah'ın adıyla.","target_tokens":[["Merhameti",["1:1:3"]],["sınırsız",["1:1:3"]],["merhamet",["1:1:4"]],["eden",["1:1:4"]],["Allah'ın",["1:1:2"]],["adıyla",["1:1:1"]]]}],["87:1","سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","87:1",{"source_ref":"87:1","text":"En yüce Rabbinin adını yücelt.","target_tokens":[["En",["87:1:4"]],["yüce",["87:1:4"]],["Rabbinin",["87:1:3"]],["adını",["87:1:2"]],["yücelt",["87:1:1"]]]}],["87:2","ٱلَّذِى خَلَقَ فَسَوَّىٰ","87:2",{"source_ref":"87:2","text":"O yarattı ve düzene koydu.","target_tokens":[["O",["87:2:1"]],["yarattı",["87:2:2"]],["ve",["87:2:3"]],["düzene",["87:2:3"]],["koydu",["87:2:3"]]]}],["87:3","وَٱلَّذِى قَدَّرَ فَهَدَىٰ","87:3",{"source_ref":"87:3","text":"O ölçüyü belirledi, ardından yol gösterdi.","target_tokens":[["O",["87:3:1"]],["ölçüyü",["87:3:2"]],["belirledi",["87:3:2"]],["ardından",["87:3:3"]],["yol",["87:3:3"]],["gösterdi",["87:3:3"]]]}],["87:4","وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","87:4",{"source_ref":"87:4","text":"O, otlağı ortaya çıkardı.","target_tokens":[["O",["87:4:1"]],["otlağı",["87:4:3"]],["ortaya",["87:4:2"]],["çıkardı",["87:4:2"]]]}],["87:5","فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","87:5",{"source_ref":"87:5","text":"Sonra onu kapkara bir çerçöpe çevirdi.","target_tokens":[["Sonra",["87:5:1"]],["onu",["87:5:1"]],["kapkara",["87:5:3"]],["bir",["87:5:2"]],["çerçöpe",["87:5:2"]],["çevirdi",["87:5:1"]]]}],["87:6","سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","87:6",{"source_ref":"87:6","text":"Sana okutacağız; böylece unutmayacaksın.","target_tokens":[["Sana",["87:6:1"]],["okutacağız",["87:6:1"]],["böylece",["87:6:2"]],["unutmayacaksın",["87:6:2","87:6:3"]]]}],["87:7","إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","87:7",{"source_ref":"87:7","text":"Ancak Allah'ın dilediği dışında. Kuşkusuz O, açık olanı ve gizli kalanı bilir.","target_tokens":[["Ancak",["87:7:1"]],["Allah'ın",["87:7:4"]],["dilediği",["87:7:2","87:7:3"]],["dışında",["87:7:1"]],["Kuşkusuz",["87:7:5"]],["O",["87:7:5"]],["açık",["87:7:7"]],["olanı",["87:7:7"]],["ve",["87:7:8"]],["gizli",["87:7:9"]],["kalanı",["87:7:8","87:7:9"]],["bilir",["87:7:6"]]]}],["87:8","وَنُيَسِّرُكَ لِلْيُسْرَىٰ","87:8",{"source_ref":"87:8","text":"Ve seni kolay olana yönelteceğiz.","target_tokens":[["Ve",["87:8:1"]],["seni",["87:8:1"]],["kolay",["87:8:2"]],["olana",["87:8:2"]],["yönelteceğiz",["87:8:1","87:8:2"]]]}],["87:9","فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","87:9",{"source_ref":"87:9","text":"Öyleyse öğüt yarar sağlarsa öğüt ver.","target_tokens":[["Öyleyse",["87:9:1"]],["öğüt",["87:9:4"]],["yarar",["87:9:3"]],["sağlarsa",["87:9:2","87:9:3"]],["öğüt",["87:9:1","87:9:4"]],["ver",["87:9:1"]]]}],["87:10","سَيَذَّكَّرُ مَن يَخْشَىٰ","87:10",{"source_ref":"87:10","text":"Korkan kişi öğüt alacaktır.","target_tokens":[["Korkan",["87:10:3"]],["kişi",["87:10:2"]],["öğüt",["87:10:1"]],["alacaktır",["87:10:1"]]]}],["87:11","وَيَتَجَنَّبُهَا ٱلْأَشْقَى","87:11",{"source_ref":"87:11","text":"En bahtsız olan ise ondan kaçınacaktır.","target_tokens":[["En",["87:11:2"]],["bahtsız",["87:11:2"]],["olan",["87:11:2"]],["ise",["87:11:1"]],["ondan",["87:11:1"]],["kaçınacaktır",["87:11:1"]]]}],["87:12","ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","87:12",{"source_ref":"87:12","text":"O, büyük ateşte yanacaktır.","target_tokens":[["O",["87:12:1"]],["büyük",["87:12:4"]],["ateşte",["87:12:3"]],["yanacaktır",["87:12:2"]]]}],["87:13","ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","87:13",{"source_ref":"87:13","text":"Sonra orada ne ölecek ne de yaşayacaktır.","target_tokens":[["Sonra",["87:13:1"]],["orada",["87:13:4"]],["ne",["87:13:2"]],["ölecek",["87:13:2","87:13:3"]],["ne",["87:13:5"]],["de",["87:13:5"]],["yaşayacaktır",["87:13:5","87:13:6"]]]}],["87:14","قَدْ أَفْلَحَ مَن تَزَكَّىٰ","87:14",{"source_ref":"87:14","text":"Arınan kişi gerçekten kurtuluşa ermiştir.","target_tokens":[["Arınan",["87:14:4"]],["kişi",["87:14:3"]],["gerçekten",["87:14:1"]],["kurtuluşa",["87:14:2"]],["ermiştir",["87:14:2"]]]}],["87:15","وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","87:15",{"source_ref":"87:15","text":"Ve Rabbinin adını andı, ardından namaz kıldı.","target_tokens":[["Ve",["87:15:1"]],["Rabbinin",["87:15:3"]],["adını",["87:15:2"]],["andı",["87:15:1"]],["ardından",["87:15:4"]],["namaz",["87:15:4"]],["kıldı",["87:15:4"]]]}],["87:16","بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","87:16",{"source_ref":"87:16","text":"Fakat siz dünya hayatını tercih ediyorsunuz.","target_tokens":[["Fakat",["87:16:1"]],["siz",["87:16:2"]],["dünya",["87:16:4"]],["hayatını",["87:16:3"]],["tercih",["87:16:2"]],["ediyorsunuz",["87:16:2"]]]}],["87:17","وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","87:17",{"source_ref":"87:17","text":"Oysa ahiret daha iyi ve daha kalıcıdır.","target_tokens":[["Oysa",["87:17:1"]],["ahiret",["87:17:1"]],["daha",["87:17:2"]],["iyi",["87:17:2"]],["ve",["87:17:3"]],["daha",["87:17:3"]],["kalıcıdır",["87:17:3"]]]}],["87:18","إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","87:18",{"source_ref":"87:18","text":"Kuşkusuz bu, önceki sayfalarda yer alır.","target_tokens":[["Kuşkusuz",["87:18:1"]],["bu",["87:18:2"]],["önceki",["87:18:5"]],["sayfalarda",["87:18:4"]],["yer",["87:18:3"]],["alır",["87:18:3"]]]}],["87:19","صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","87:19",{"source_ref":"87:19","text":"İbrahim'in ve Musa'nın sayfalarında.","target_tokens":[["İbrahim'in",["87:19:2"]],["ve",["87:19:3"]],["Musa'nın",["87:19:3"]],["sayfalarında",["87:19:1"]]]}]]}
