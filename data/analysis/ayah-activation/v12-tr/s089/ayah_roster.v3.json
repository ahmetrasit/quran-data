{"protocol":"v12-cross-run-ayah-roster-v3","surah":89,"language":"tr","baseline_sha256":"a37c11d5b08467b822d46cf038db80f3b2673bd6fbe0563d7bd1e45647b68552","columns":["ayah_ref","text_ar","baseline_source_ref","baseline"],"rows":[["89:0","بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","1:1",{"source_ref":"1:1","text":"Merhameti sınırsız, merhamet eden Allah'ın adıyla.","target_tokens":[["Merhameti",["1:1:3"]],["sınırsız",["1:1:3"]],["merhamet",["1:1:4"]],["eden",["1:1:4"]],["Allah'ın",["1:1:2"]],["adıyla",["1:1:1"]]]}],["89:1","وَٱلْفَجْرِ","89:1",{"source_ref":"89:1","text":"Tan vaktine andolsun!","target_tokens":[["Tan",["89:1:1"]],["vaktine",["89:1:1"]],["andolsun",["89:1:1"]]]}],["89:2","وَلَيَالٍ عَشْرٍۢ","89:2",{"source_ref":"89:2","text":"On geceye andolsun!","target_tokens":[["On",["89:2:2"]],["geceye",["89:2:1"]],["andolsun",["89:2:1","89:2:2"]]]}],["89:3","وَٱلشَّفْعِ وَٱلْوَتْرِ","89:3",{"source_ref":"89:3","text":"Çifte ve teke andolsun!","target_tokens":[["Çifte",["89:3:1"]],["ve",["89:3:2"]],["teke",["89:3:2"]],["andolsun",["89:3:1","89:3:2"]]]}],["89:4","وَٱلَّيْلِ إِذَا يَسْرِ","89:4",{"source_ref":"89:4","text":"Geçip gittiğinde geceye andolsun!","target_tokens":[["Geçip",["89:4:3"]],["gittiğinde",["89:4:2","89:4:3"]],["geceye",["89:4:1"]],["andolsun",["89:4:1"]]]}],["89:5","هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ","89:5",{"source_ref":"89:5","text":"Bunlarda akıl sahibi için bir yemin yok mu?","target_tokens":[["Bunlarda",["89:5:2","89:5:3"]],["akıl",["89:5:6"]],["sahibi",["89:5:5","89:5:6"]],["için",["89:5:5"]],["bir",["89:5:4"]],["yemin",["89:5:4"]],["yok",["89:5:1"]],["mu",["89:5:1"]]]}],["89:6","أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","89:6",{"source_ref":"89:6","text":"Rabbinin Âd'a ne yaptığını görmedin mi?","target_tokens":[["Rabbinin",["89:6:5"]],["Âd'a",["89:6:6"]],["ne",["89:6:3"]],["yaptığını",["89:6:4"]],["görmedin",["89:6:1","89:6:2"]],["mi",["89:6:1"]]]}],["89:7","إِرَمَ ذَاتِ ٱلْعِمَادِ","89:7",{"source_ref":"89:7","text":"Sütunlar sahibi İrem'e,","target_tokens":[["Sütunlar",["89:7:3"]],["sahibi",["89:7:2","89:7:3"]],["İrem'e",["89:7:1"]]]}],["89:8","ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ","89:8",{"source_ref":"89:8","text":"Ülkelerde benzeri yaratılmamış olan,","target_tokens":[["Ülkelerde",["89:8:5","89:8:6"]],["benzeri",["89:8:4"]],["yaratılmamış",["89:8:2","89:8:3"]],["olan",["89:8:1"]]]}],["89:9","وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ","89:9",{"source_ref":"89:9","text":"Vadide kayaları oyan Semûd'a da,","target_tokens":[["Vadide",["89:9:5"]],["kayaları",["89:9:4"]],["oyan",["89:9:3"]],["Semûd'a",["89:9:1","89:9:2"]],["da",["89:9:1"]]]}],["89:10","وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","89:10",{"source_ref":"89:10","text":"Kazıklar sahibi Firavun'a da.","target_tokens":[["Kazıklar",["89:10:3"]],["sahibi",["89:10:2","89:10:3"]],["Firavun'a",["89:10:1"]],["da",["89:10:1"]]]}],["89:11","ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ","89:11",{"source_ref":"89:11","text":"Onlar ülkelerde azgınlık ettiler.","target_tokens":[["Onlar",["89:11:1"]],["ülkelerde",["89:11:3","89:11:4"]],["azgınlık",["89:11:2"]],["ettiler",["89:11:2"]]]}],["89:12","فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ","89:12",{"source_ref":"89:12","text":"Böylece oralarda bozgunculuğu artırdılar.","target_tokens":[["Böylece",["89:12:1"]],["oralarda",["89:12:2"]],["bozgunculuğu",["89:12:3"]],["artırdılar",["89:12:1"]]]}],["89:13","فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","89:13",{"source_ref":"89:13","text":"Bunun üzerine Rabbin üzerlerine bir azap kamçısı yağdırdı.","target_tokens":[["Bunun",["89:13:1"]],["üzerine",["89:13:1"]],["Rabbin",["89:13:3"]],["üzerlerine",["89:13:2"]],["bir",["89:13:4"]],["azap",["89:13:5"]],["kamçısı",["89:13:4","89:13:5"]],["yağdırdı",["89:13:1"]]]}],["89:14","إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","89:14",{"source_ref":"89:14","text":"Kuşkusuz Rabbin gözetlemektedir.","target_tokens":[["Kuşkusuz",["89:14:1","89:14:3"]],["Rabbin",["89:14:2"]],["gözetlemektedir",["89:14:3"]]]}],["89:15","فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْت