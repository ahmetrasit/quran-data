]],["tüketiyorsunuz",["89:19:1","89:19:3"]]]}],["89:20","وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا","89:20",{"source_ref":"89:20","text":"Malı da çok büyük bir sevgiyle seviyorsunuz.","target_tokens":[["Malı",["89:20:2"]],["da",["89:20:1"]],["çok",["89:20:4"]],["büyük",["89:20:4"]],["bir",["89:20:3"]],["sevgiyle",["89:20:3"]],["seviyorsunuz",["89:20:1"]]]}],["89:21","كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا","89:21",{"source_ref":"89:21","text":"Hayır! Yer tekrar tekrar ezildiğinde,","target_tokens":[["Hayır",["89:21:1"]],["Yer",["89:21:4"]],["tekrar",["89:21:5"]],["tekrar",["89:21:6"]],["ezildiğinde",["89:21:2","89:21:3"]]]}],["89:22","وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا","89:22",{"source_ref":"89:22","text":"Rabbin ve melek sıra sıra geldiğinde,","target_tokens":[["Rabbin",["89:22:2"]],["ve",["89:22:3"]],["melek",["89:22:3"]],["sıra",["89:22:4"]],["sıra",["89:22:5"]],["geldiğinde",["89:22:1"]]]}],["89:23","وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","89:23",{"source_ref":"89:23","text":"O gün cehennem getirilir. O gün insan hatırlar; fakat hatırlamanın ona ne yararı olur?","target_tokens":[["O",["89:23:2"]],["gün",["89:23:2"]],["cehennem",["89:23:3"]],["getirilir",["89:23:1"]],["O",["89:23:4"]],["gün",["89:23:4"]],["insan",["89:23:6"]],["hatırlar",["89:23:5"]],["fakat",["89:23:7"]],["hatırlamanın",["89:23:9"]],["ona",["89:23:8"]],["ne",["89:23:7"]],["yararı",["89:23:7","89:23:9"]],["olur",["89:23:8"]]]}],["89:24","يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","89:24",{"source_ref":"89:24","text":"“Keşke hayatım için önceden bir şeyler yapsaydım!” der.","target_tokens":[["Keşke",["89:24:2"]],["hayatım",["89:24:4"]],["için",["89:24:4"]],["önceden",["89:24:3"]],["bir",["89:24:3"]],["şeyler",["89:24:3"]],["yapsaydım",["89:24:3"]],["der",["89:24:1"]]]}],["89:25","فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ","89:25",{"source_ref":"89:25","text":"O gün hiç kimse onun azabı gibi azap edemez.","target_tokens":[["O",["89:25:1"]],["gün",["89:25:1"]],["hiç",["89:25:5"]],["kimse",["89:25:5"]],["onun",["89:25:4"]],["azabı",["89:25:4"]],["gibi",["89:25:4"]],["azap",["89:25:3"]],["edemez",["89:25:2","89:25:3"]]]}],["89:26","وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ","89:26",{"source_ref":"89:26","text":"Hiç kimse de onun bağlayışı gibi bağlayamaz.","target_tokens":[["Hiç",["89:26:4"]],["kimse",["89:26:4"]],["de",["89:26:1"]],["onun",["89:26:3"]],["bağlayışı",["89:26:3"]],["gibi",["89:26:3"]],["bağlayamaz",["89:26:1","89:26:2"]]]}],["89:27","يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","89:27",{"source_ref":"89:27","text":"Ey huzur bulmuş ruh!","target_tokens":[["Ey",["89:27:1"]],["huzur",["89:27:3"]],["bulmuş",["89:27:3"]],["ruh",["89:27:2"]]]}],["89:28","ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ","89:28",{"source_ref":"89:28","text":"Sen razı, senden de razı olunmuş olarak Rabbine dön.","target_tokens":[["Sen",["89:28:1","89:28:4"]],["razı",["89:28:4"]],["senden",["89:28:5"]],["de",["89:28:5"]],["razı",["89:28:5"]],["olunmuş",["89:28:5"]],["olarak",["89:28:4","89:28:5"]],["Rabbine",["89:28:2","89:28:3"]],["dön",["89:28:1"]]]}],["89:29","فَٱدْخُلِى فِى عِبَٰدِى","89:29",{"source_ref":"89:29","text":"Kullarımın arasına gir.","target_tokens":[["Kullarımın",["89:29:3"]],["arasına",["89:29:2"]],["gir",["89:29:1"]]]}],["89:30","وَٱدْخُلِى جَنَّتِى","89:30",{"source_ref":"89:30","text":"Cennetime de gir.","target_tokens":[["Cennetime",["89:30:2"]],["de",["89:30:1"]],["gir",["89:30:1"]]]}]]}
