{"protocol":"v12-cross-run-ayah-roster-v3","surah":85,"language":"tr","baseline_sha256":"28392d9eba1408ea5a0cf259c20a1ccd387d5a1eddbd41313a7ff97b8fbdba4e","columns":["ayah_ref","text_ar","baseline_source_ref","baseline"],"rows":[["85:0","بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","1:1",{"source_ref":"1:1","text":"Merhameti sınırsız, merhamet eden Allah'ın adıyla.","target_tokens":[["Merhameti",["1:1:3"]],["sınırsız",["1:1:3"]],["merhamet",["1:1:4"]],["eden",["1:1:4"]],["Allah'ın",["1:1:2"]],["adıyla",["1:1:1"]]]}],["85:1","وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ","85:1",{"source_ref":"85:1","text":"Burçlu göğe andolsun.","target_tokens":[["Burçlu",["85:1:2","85:1:3"]],["göğe",["85:1:1"]],["andolsun",["85:1:1"]]]}],["85:2","وَٱلْيَوْمِ ٱلْمَوْعُودِ","85:2",{"source_ref":"85:2","text":"Vadedilmiş güne andolsun.","target_tokens":[["Vadedilmiş",["85:2:2"]],["güne",["85:2:1"]],["andolsun",["85:2:1"]]]}],["85:3","وَشَاهِدٍۢ وَمَشْهُودٍۢ","85:3",{"source_ref":"85:3","text":"Tanıklık edene ve tanıklık edilene andolsun.","target_tokens":[["Tanıklık",["85:3:1"]],["edene",["85:3:1"]],["ve",["85:3:2"]],["tanıklık",["85:3:2"]],["edilene",["85:3:2"]],["andolsun",["85:3:1","85:3:2"]]]}],["85:4","قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ","85:4",{"source_ref":"85:4","text":"Hendek sahipleri öldürüldü.","target_tokens":[["Hendek",["85:4:3"]],["sahipleri",["85:4:2"]],["öldürüldü",["85:4:1"]]]}],["85:5","ٱلنَّارِ ذَاتِ ٱلْوَقُودِ","85:5",{"source_ref":"85:5","text":"Yakıt dolu ateşin.","target_tokens":[["Yakıt",["85:5:3"]],["dolu",["85:5:2","85:5:3"]],["ateşin",["85:5:1"]]]}],["85:6","إِذْ هُمْ عَلَيْهَا قُعُودٌۭ","85:6",{"source_ref":"85:6","text":"Hani onlar onun başında oturuyorlardı.","target_tokens":[["Hani",["85:6:1"]],["onlar",["85:6:2"]],["onun",["85:6:3"]],["başında",["85:6:3"]],["oturuyorlardı",["85:6:4"]]]}],["85:7","وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ","85:7",{"source_ref":"85:7","text":"Onlar da inananlara yaptıklarına tanıktılar.","target_tokens":[["Onlar",["85:7:1"]],["da",["85:7:1"]],["inananlara",["85:7:5"]],["yaptıklarına",["85:7:2","85:7:3","85:7:4"]],["tanıktılar",["85:7:6"]]]}],["85:8","وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ","85:8",{"source_ref":"85:8","text":"Onlardan sırf güçlü ve övgüye layık Allah'a inandıkları için öç aldılar.","target_tokens":[["Onlardan",["85:8:3"]],["sırf",["85:8:1","85:8:4"]],["güçlü",["85:8:8"]],["ve",["85:8:8","85:8:9"]],["övgüye",["85:8:9"]],["layık",["85:8:9"]],["Allah'a",["85:8:7"]],["inandıkları",["85:8:5","85:8:6"]],["için",["85:8:5"]],["öç",["85:8:2"]],["aldılar",["85:8:2"]]]}],["85:9","ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ","85:9",{"source_ref":"85:9","text":"Göklerin ve yerin egemenliği O'nundur; Allah her şeye tanıktır.","target_tokens":[["Göklerin",["85:9:4"]],["ve",["85:9:5"]],["yerin",["85:9:5"]],["egemenliği",["85:9:3"]],["O'nundur",["85:9:1","85:9:2"]],["Allah",["85:9:6"]],["her",["85:9:8"]],["şeye",["85:9:7","85:9:9"]],["tanıktır",["85:9:10"]]]}],["85:10","إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ","85:10",{"source_ref":"85:10","text":"İnanan erkeklere ve kadınlara eziyet edip sonra tövbe etmeyenler için cehennem azabı ve yakıcı ateş azabı vardır.","target_tokens":[["İnanan",["85:10:4"]],["erkeklere",["85:10:4"]],["ve",["85:10:5"]],["kadınlara",["85:10:5"]],["eziyet",["85:10:3"]],["edip",["85:10:3"]],["sonra",["85:10:6"]],["tövbe",["85:10:8"]],["etmeyenler",["85:10:2","85:10:7","85:10:8"]],["için",["85:10:9"]],["cehennem",["85:10:11"]],["azabı",["85:10:10"]],["ve",["85:10:12"]],["yakıcı",["85:10:14"]],["ateş",["85:10:14"]],["azabı",["85:10:13"]],["vardır",["85:10:1","85:10:9","85:10:12"]]]}],["85:11","إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ","85:11",{"source_ref":"85:11","text":"İnanıp iyi işler yapanlar için altlarından ırmaklar akan bahçeler vardır. Büyük başarı budur.","target_tokens":[["İnanıp",["85:11:3"]],["iyi",["85:11:5"]],["işler",["85:11:5"]],["yapanlar",["85:11:2","85:11:4"]],["için",["85:11:6"]],["altlarından",["85:11:9","85:11:10"]],["ırmaklar",["85:11:11"]],["akan",["85:11:8"]],["bahçeler",["85:11:7"]],["vardır",["85:11:1","85:11:6"]],["Büyük",["85:11:14"]],["başarı",["85:11:13"]],["budur",["85:11:12"]]]}],["85:12","إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ","85:12",{"source_ref":"85:12","text":"Rabbinin yakalaması gerçekten çetindir.","target_tokens":[["Rabbinin",["85:12:3"]],["yakalaması",["85:12:2"]],["gerçekten",["85:12:1","85:12:4"]],["çetindir",["85:12:4"]]]}],["85:13","إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ","85:13",{"source_ref":"85:13","text":"Gerçekten başlatan ve tekrarlayan O'dur.","target_tokens":[["Gerçekten",["85:13:1"]],["başlatan",["85:13:3"]],["ve",["85:13:4"]],["tekrarlayan",["85:13:4"]],["O'dur",["85:13:1","85:13:2"]]]}],["85:14","وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ","85:14",{"source_ref":"85:14","text":"O, çok bağışlayan ve çok sevendir.","target_tokens":[["O",["85:14:1"]],["çok",["85:14:2"]],["bağışlayan",["85:14:2"]],["ve",["85:14:2","85:14:3"]],["çok",["85:14:3"]],["sevendir",["85:14:3"]]]}],["85:15","ذُو ٱلْعَرْشِ ٱلْمَجِيدُ","85:15",{"source_ref":"85:15","text":"O, Arş'ın sahibi ve yücedir.","target_tokens":[["O",["85:15:1"]],["Arş'ın",["85:15:2"]],["sahibi",["85:15:1"]],["ve",["85:15:1","85:15:3"]],["yücedir",["85:15:3"]]]}],["85:16","فَعَّالٌۭ لِّمَا يُرِيدُ","85:16",{"source_ref":"85:16","text":"Dilediğini yapar.","target_tokens":[["Dilediğini",["85:16:2","85:16:3"]],["yapar",["85:16:1"]]]}],["85:17","هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ","85:17",{"source_ref":"85:17","text":"Orduların haberi sana geldi mi?","target_tokens":[["Orduların",["85:17:4"]],["haberi",["85:17:3"]],["sana",["85:17:2"]],["geldi",["85:17:2"]],["mi",["85:17:1"]]]}],["85:18","فِرْعَوْنَ وَثَمُودَ","85:18",{"source_ref":"85:18","text":"Firavun'un ve Semud'un?","target_tokens":[["Firavun'un",["85:18:1"]],["ve",["85:18:2"]],["Semud'un",["85:18:2"]]]}],["85:19","بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ","85:19",{"source_ref":"85:19","text":"Hayır, inkâr edenler yalanlama içindedir.","target_tokens":[["Hayır",["85:19:1"]],["inkâr",["85:19:3"]],["edenler",["85:19:2","85:19:3"]],["yalanlama",["85:19:5"]],["içindedir",["85:19:4"]]]}],["85:20","وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ","85:20",{"source_ref":"85:20","text":"Allah ise onları arkalarından kuşatmıştır.","target_tokens":[["Allah",["85:20:1"]],["ise",["85:20:1"]],["onları",["85:20:3"]],["arkalarından",["85:20:2","85:20:3"]],["kuşatmıştır",["85:20:4"]]]}],["85:21","بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ","85:21",{"source_ref":"85:21","text":"Aksine, o yüce bir Kur'an'dır.","target_tokens":[["Aksine",["85:21:1"]],["o",["85:21:2"]],["yüce",["85:21:4"]],["bir",["85:21:3"]],["Kur'an'dır",["85:21:3"]]]}],["85:22","فِى لَوْحٍۢ مَّحْفُوظٍۭ","85:22",{"source_ref":"85:22","text":"Korunmuş bir levhadadır.","target_tokens":[["Korunmuş",["85:22:3"]],["bir",["85:22:2"]],["levhadadır",["85:22:1","85:22:2"]]]}]]}
